rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidInvitacion(data) {
      return data.keys().hasAll(['id', 'token', 'claveAcceso', 'nombre', 'email', 'creadoEn', 'accesosTotales', 'estado', 'enviadoPorCorreo']) &&
        data.keys().hasOnly(['id', 'token', 'claveAcceso', 'nombre', 'email', 'nota', 'creadoEn', 'ultimoAcceso', 'accesosTotales', 'estado', 'enviadoPorCorreo']) &&
        data.id is string && data.id.size() <= 128 &&
        data.token is string && data.token.size() <= 128 &&
        data.claveAcceso is string && data.claveAcceso.size() <= 64 &&
        data.nombre is string && data.nombre.size() <= 120 &&
        data.email is string && data.email.size() <= 160 &&
        (!('nota' in data) || (data.nota is string && data.nota.size() <= 500)) &&
        data.creadoEn is string && data.creadoEn.size() <= 64 &&
        (!('ultimoAcceso' in data) || (data.ultimoAcceso is string && data.ultimoAcceso.size() <= 64)) &&
        data.accesosTotales is number && data.accesosTotales >= 0 &&
        (data.estado == 'activo' || data.estado == 'revocado') &&
        data.enviadoPorCorreo is bool;
    }

    match /invitaciones/{invitacionId} {
      allow get, list: if true;
      allow create: if isValidId(invitacionId) && isValidInvitacion(request.resource.data);
      allow update: if isValidId(invitacionId) && isValidInvitacion(request.resource.data);
      allow delete: if isValidId(invitacionId);
    }
  }
}
